# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# originali asset non compressi
/_assets_originali

# --- Muri Parlanti: build e artefatti generati ---
# Capacitor / Android (tengo il progetto nativo, escludo solo gli output di build)
/android/.gradle/
/android/build/
/android/app/build/
/android/local.properties
/android/.idea/
/android/app/release/
/android/app/debug/

# Copia web generata da Capacitor (rigenerabile con "npx cap sync")
/www/

# Pacchetti Android
*.apk
*.aab
*.keystore

# Deliverable di stampa rigenerabili
sticker-*.png
sticker-*.pdf

# --- Deliverable di design/stampa rigenerabili: NON versionati ---
# PDF/PNG/HTML delle varianti post-it, script che li generano, font usati
# solo dalle pagine di design, loghi/manifesti, sticker e backup locali.
/design-postit-*
/muri-parlanti-logo*
/manifesto-*
/sticker2-*
/sticker-qr/
/sticker_art.py
/make_sticker2.py
/make_manifesto.py
/gen_*_pdf.cjs
/backup-*.json
/__pycache__/
/fonts/
